{
  "name": "pi-coralbricks-provider",
  "version": "1.0.39",
  "description": "CoralBricks provider extension for pi - Access DeepSeek V4.1 Flash through the Coral Inference API",
  "author": "monotykamary",
  "homepage": "https://github.com/Coral-Bricks-AI/pi-coralbricks-provider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coral-Bricks-AI/pi-coralbricks-provider.git"
  },
  "bugs": {
    "url": "https://github.com/Coral-Bricks-AI/pi-coralbricks-provider/issues"
  },
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "update-models": "node scripts/update-models.js",
    "test:pi": "node scripts/test-pi-compat.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "provider",
    "coralbricks",
    "coral",
    "ai",
    "llm",
    "glm",
    "deepseek",
    "deepseek"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "settings.ts",
    "auth.ts",
    "park.ts",
    "guard.ts",
    "sync-policy.ts",
    "models.json",
    "deprecated-models.json",
    "custom-models.json",
    "patch.json",
    "scripts/update-models.js",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^22.20.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}
